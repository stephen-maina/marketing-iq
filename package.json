{
  "name": "marketing-iq",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node tools/MarketingIQ.Portable/build.mjs",
    "check:generated": "node tools/MarketingIQ.Portable/build.mjs --check",
    "test": "npm run build && node --test tests/portable/*.test.mjs tests/hosted-preflight/review-packet.test.mjs",
    "package": "npm run build && node tools/MarketingIQ.Portable/package.mjs",
    "build:plugin": "npm run build && node tools/MarketingIQ.Portable/plugin.mjs",
    "test:plugin": "npm run build:plugin && node --test tests/native-plugin/*.test.mjs",
    "test:package": "npm run package && node --test tests/portable-package/*.test.mjs",
    "test:parity": "npm run build && node --test tests/portable-parity/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "~5.9.3"
  }
}
